; The room's surfaces: the shell and every piece of furniture, lit per vertex.
;
; Light is a sky-and-floor hemisphere, a key from above the front left, a
; front light from the camera's side, and four lamps. A lamp is a soft ball:
; its light falls off as 1 / (d^2 + r^2), is windowed to nothing at its
; distance, and is capped, so a lamp against a wall cannot blow the wall
; out. What gives off light adds its emission: always, or while its item is
; switched on (the vertex's emission alpha says which).
;
; Inputs: v0 position (s16, tiles x 2048), v1 normal (s8, x 127), v2 colour
; (u8), v3 emission (u8, rgb x strength / 4), v4 texture coordinate (s16,
; x 1024). A uniform may be read once per instruction.

.fvec mvp[4]
.fvec model[3]
; x: position scale, y: normal scale, z: 1/255, w: texture coordinate scale
.fvec scales
; x: on (0 or 1), y: emission multiplier
.fvec inst
; added to the colour: a selection's glow, a refusal's red
.fvec tint
; the hemisphere: the mean of the sky's colour and the floor's, and half their difference (a normal
; straight up has the sky's, straight down the floor's)
.fvec hemi
.fvec tilt
.fvec keydir
.fvec keycol
.fvec frontdir
.fvec frontcol
; xyz: where, w: radius squared
.fvec lamppos[4]
; rgb: colour x intensity, w: 1 / distance squared
.fvec lampcol[4]
; x: wrap scale, y: wrap offset, z: lamp cap
.fvec shade
; Which lamps reach this item: a lamp that cannot is not computed (its four
; calls are most of the program's length).
.bool lamp0
.bool lamp1
.bool lamp2
.bool lamp3
; Whether any lamp reaches this item (it then needs its place in the room), and whether this draw
; gives off light of its own.
.bool anylamp
.bool emits
; Whether the model turns its normals (the island's chunks and cells stand as they are: theirs are the room's).
.bool turned

.constf consts(0.0, 1.0, 0.5, 2.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias innrm v1
.alias inclr v2
.alias inemit v3
.alias intex v4

.proc lamp
	; r6 = d, from the vertex to the lamp; r7.x = d^2
	add r6.xyz, r12.xyz, -r1.xyz
	dp3 r7.x, r6, r6
	; r7.y = 1 / (d^2 + r^2)
	add r7.y, r12.w, r7.x
	rcp r7.y, r7.y
	; r7.z = window: (1 - d^2 / distance^2)^2, at least 0
	mul r7.z, r13.w, r7.x
	add r7.z, ones, -r7.z
	max r7.z, zeros, r7.z
	mul r7.z, r7.z, r7.z
	mul r7.y, r7.y, r7.z
	; r7.w = wrapped n.l toward the lamp
	rsq r7.x, r7.x
	mul r6.xyz, r6.xyz, r7.xxx
	dp3 r7.w, r6, r3
	mad r7.w, r7.wwww, r14.xxxx, r14.yyyy
	max r7.w, zeros, r7.w
	mul r7.y, r7.y, r7.w
	mul r8.xyz, r13.xyz, r7.yyy
	min r8.xyz, r14.zzz, r8.xyz
	add r5.xyz, r5.xyz, r8.xyz
.end

.proc turn
	; the normal turned as the model turns it
	mov r2, r3
	dp3 r3.x, model[0], r2
	dp3 r3.y, model[1], r2
	dp3 r3.z, model[2], r2
.end

.proc world
	; r1 = in the room
	dp4 r1.x, model[0], r0
	dp4 r1.y, model[1], r0
	dp4 r1.z, model[2], r0
.end

.proc emission
	; what gives off light: always, or while its item is on
	mul r10, scales.zzzz, inemit
	add r11.x, ones, -r10.w
	mul r11.x, inst.x, r11.x
	add r11.x, r10.w, r11.x
	mul r11.x, inst.y, r11.x
	mul r10.xyz, r10.xyz, r11.xxx
	add r9.xyz, r9.xyz, r10.xyz
.end

.proc lamp_a
	mov r12, lamppos[0]
	mov r13, lampcol[0]
	call lamp
.end

.proc lamp_b
	mov r12, lamppos[1]
	mov r13, lampcol[1]
	call lamp
.end

.proc lamp_c
	mov r12, lamppos[2]
	mov r13, lampcol[2]
	call lamp
.end

.proc lamp_d
	mov r12, lamppos[3]
	mov r13, lampcol[3]
	call lamp
.end

.proc main
	; Position in the item's frame, in tiles.
	mul r0.xyz, scales.xxx, inpos.xyz
	mov r0.w, ones
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0
	; r3 = the normal in the room (unit already: the model only turns, and the pack's normals are unit)
	mul r3.xyz, scales.yyy, innrm.xyz
	callu turned, turn

	; r5 = the hemisphere: the floor's colour below, the sky's above (a multiply-add a channel)
	mov r5, hemi
	mad r5.xyz, r3.yyy, tilt.xyz, r5.xyz

	; the key and the front light, wrapped a little so a side in shade keeps some form
	mov r14, shade
	dp3 r6.x, keydir, r3
	mad r6.x, r6.xxxx, shade.xxxx, r14.yyyy
	max r6.x, zeros, r6.x
	mad r5.xyz, r6.xxx, keycol.xyz, r5.xyz
	dp3 r6.x, frontdir, r3
	max r6.x, zeros, r6.x
	mad r5.xyz, r6.xxx, frontcol.xyz, r5.xyz

	; the lamps that reach this item
	callu anylamp, world
	callu lamp0, lamp_a
	callu lamp1, lamp_b
	callu lamp2, lamp_c
	callu lamp3, lamp_d

	; colour x light, plus emission, plus the tint
	mul r9, scales.zzzz, inclr
	mul r9.xyz, r9.xyz, r5.xyz
	callu emits, emission
	add r9.xyz, tint.xyz, r9.xyz
	mov outclr, r9
	mul r0.xy, scales.ww, intex.xy
	mov r0.zw, zeros
	mov outtc0, r0
	end
.end
