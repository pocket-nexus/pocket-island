{
  // Type-checks the console's interface (bun run typecheck) with PocketJS's settings; its JSX is
  // Solid's, which babel-preset-solid transforms when the app is built.
  "extends": "../../vendor/pocketjs/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "jsxImportSource": "solid-js",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    // PocketJS's paths (a "paths" here replaces the base's), and the one copy of Solid the app is built with.
    "paths": {
      "solid-js": ["../../node_modules/solid-js"],
      "solid-js/*": ["../../node_modules/solid-js/*"],
      "@pocketjs/framework/hot": ["../../vendor/pocketjs/framework/src/hot.ts"],
      "@pocketjs/framework/display": ["../../vendor/pocketjs/framework/src/display.ts"],
      "@pocketjs/framework/host": ["../../vendor/pocketjs/framework/src/host.ts"],
      "@pocketjs/framework/modality": ["../../vendor/pocketjs/framework/src/modality.ts"],
      "@pocketjs/framework": ["../../vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/animation": ["../../vendor/pocketjs/framework/src/animation.ts"],
      "@pocketjs/framework/components": ["../../vendor/pocketjs/framework/src/components.ts"],
      "@pocketjs/framework/gesture": ["../../vendor/pocketjs/framework/src/gesture.ts"],
      "@pocketjs/framework/input": ["../../vendor/pocketjs/framework/src/input-api.ts"],
      "@pocketjs/framework/kinetics": ["../../vendor/pocketjs/framework/src/kinetics.ts"],
      "@pocketjs/framework/lifecycle": ["../../vendor/pocketjs/framework/src/lifecycle.ts"],
      "@pocketjs/framework/manifest": ["../../vendor/pocketjs/framework/src/manifest/index.ts"],
      "@pocketjs/framework/platform": ["../../vendor/pocketjs/framework/src/platform.ts"],
      "@pocketjs/framework/prelude": ["../../vendor/pocketjs/framework/src/prelude.ts"],
      "@pocketjs/framework/renderer": ["../../vendor/pocketjs/framework/src/renderer.ts"],
      "@pocketjs/framework/solid": ["../../vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/solid/std": ["../../vendor/pocketjs/framework/src/std-microts.ts"],
      "@pocketjs/framework/solid/components": ["../../vendor/pocketjs/framework/src/components.ts"],
      "@pocketjs/framework/solid/lifecycle": ["../../vendor/pocketjs/framework/src/lifecycle.ts"],
      "@pocketjs/framework/solid/renderer": ["../../vendor/pocketjs/framework/src/renderer-solid.ts"],
      "@pocketjs/framework/virtual-list": ["../../vendor/pocketjs/framework/src/virtual-list.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "test/*.ts"]
}
